      "bundleIdentifier": "com.aidanlconnolly.pocketskirmish",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "UIStatusBarHidden": true
      }
    },
    "android": {
      "package": "com.aidanlconnolly.pocketskirmish"
    }
  }
}
