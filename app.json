{
  "expo": {
    "name": "Pocket Skirmish",
    "slug": "pocket-skirmish",
    "version": "1.0.0",
    "orientation": "landscape",
    "scheme": "pocketskirmish",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070d0a",
